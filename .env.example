# ============================================
# NOVA BARBER SHOP — Variables de entorno
# ============================================
# Copia este archivo, renómbralo a .env, y llena los valores.

# --- BACKEND (Render) ---
# Copiá el connection string completo de Neon (Dashboard > Connection Details > Connection string)
# Formato: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://nova_user:TU_PASSWORD@ep-xxx.us-east-2.aws.neon.tech/nova_barber?sslmode=require

# Secret para firmar los JWT. En Render usá "Generate" para que lo cree automáticamente.
NOVA_SECRET_KEY=cambia-esto-en-produccion

# --- FRONTEND (Vercel) ---
# La URL pública de tu backend en Render (sin / al final).
# Ejemplo: https://nova-api.onrender.com
VITE_API_URL=https://nova-api.onrender.com
